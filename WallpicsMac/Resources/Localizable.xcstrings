    "It appears in the Pets tab and we notify you. Put it on your desktop like any other pet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es erscheint im Tab „Haustiere“ und wir benachrichtigen dich. Setze es wie jedes andere Haustier auf deinen Schreibtisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece en la pestaña Mascotas y te avisamos. Ponlo en tu escritorio como cualquier otra mascota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il apparaît dans l'onglet Animaux et nous vous prévenons. Placez-le sur votre bureau comme n'importe quel autre animal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ペット」タブに表示され、通知が届きます。ほかのペットと同じようにデスクトップに置けます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele aparece na aba Pets e avisamos você. Coloque-o na sua mesa como qualquer outro pet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он появится во вкладке «Питомцы», и мы вас уведомим. Поставьте его на рабочий стол, как любого другого питомца."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会出现在“宠物”标签页中，我们会通知你。像其他宠物一样把它放到桌面上。"
          }
        }
      }
    },
