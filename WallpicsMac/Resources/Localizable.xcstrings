    "Sent %@ · taking longer than usual. Still waiting to hear back — you can remove it or send the photos again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesendet %@ · dauert länger als üblich. Wir warten noch auf Antwort – du kannst es entfernen oder die Fotos erneut senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado %@ · está tardando más de lo habitual. Seguimos esperando respuesta: puedes eliminarlo o volver a enviar las fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyé %@ · plus long que d'habitude. Toujours en attente de réponse : vous pouvez le retirer ou renvoyer les photos."
