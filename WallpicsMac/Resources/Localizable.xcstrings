    "Photos, videos, GIFs, Metal shaders and Rive animations — they all work, watermark-free with Pro." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, Videos, GIFs, Metal-Shader und Rive-Animationen – alles funktioniert, mit Pro ohne Wasserzeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, vídeos, GIF, shaders de Metal y animaciones Rive: todo funciona, sin marca de agua con Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos, vidéos, GIF, shaders Metal et animations Rive — tout fonctionne, sans filigrane avec Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真、動画、GIF、Metal シェーダー、Rive アニメーションすべてに対応。Pro なら透かしなし。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, vídeos, GIFs, shaders Metal e animações Rive — tudo funciona, sem marca d'água com o Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото, видео, GIF, шейдеры Metal и анимации Rive — всё работает, а с Pro без водяного знака."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片、视频、GIF、Metal 着色器和 Rive 动画都能用，Pro 版无水印。"
          }
        }
      }
    },
