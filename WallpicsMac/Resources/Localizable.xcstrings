    "You've already sent one of these photos. Each pet only needs to be sent once — it appears in your list after review." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eines dieser Fotos hast du bereits gesendet. Jedes Haustier muss nur einmal gesendet werden – es erscheint nach der Prüfung in deiner Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya has enviado una de estas fotos. Cada mascota solo hay que enviarla una vez: aparecerá en tu lista tras la revisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà envoyé l'une de ces photos. Chaque animal n'a besoin d'être envoyé qu'une fois — il apparaîtra dans votre liste après validation."
          }
        },
        "ja" : {
          "stringUnit" : {
