    "We couldn't build a pet from these photos. Try clearer shots of one pet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus diesen Fotos konnten wir kein Haustier bauen. Versuche klarere Aufnahmen eines Haustiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos crear una mascota con estas fotos. Prueba con fotos más claras de una sola mascota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de créer un animal à partir de ces photos. Essayez des photos plus nettes d'un seul animal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真からペットを作成できませんでした。1匹のペットのより鮮明な写真をお試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos criar um pet com essas fotos. Tente fotos mais nítidas de um único pet."
          }
