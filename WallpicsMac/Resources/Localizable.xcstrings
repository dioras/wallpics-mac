    "A person checks the photos, then our pipeline animates your pet so it can look around. Usually within 48 hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Mensch prüft die Fotos, dann animiert unsere Pipeline dein Haustier, damit es sich umsehen kann. Meist innerhalb von 48 Stunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una persona revisa las fotos y luego nuestro sistema anima a tu mascota para que pueda mirar alrededor. Normalmente en 48 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une personne vérifie les photos, puis notre pipeline anime votre animal pour qu'il regarde autour de lui. Généralement sous 48 heures."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "担当者が写真を確認し、パイプラインがペットをアニメーション化して周りを見回せるようにします。通常48時間以内。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pessoa confere as fotos e depois nosso sistema anima seu pet para que ele olhe ao redor. Normalmente em até 48 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Человек проверяет фото, затем наш конвейер оживляет питомца, чтобы он мог оглядываться. Обычно в течение 48 часов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由人工检查照片，然后我们的流程为宠物制作动画，让它能环顾四周。通常在 48 小时内完成。"
          }
        }
      }
    },
