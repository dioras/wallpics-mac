        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно из этих фото вы уже отправляли. Каждого питомца нужно отправить только один раз — он появится в списке после проверки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
