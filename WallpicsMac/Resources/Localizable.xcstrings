    },
    "macOS wallpaper store not found — pick any Aerial wallpaper once in System Settings, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-Hintergrundspeicher nicht gefunden – wähle einmal einen Luftaufnahme-Hintergrund in den Systemeinstellungen und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
