    "Send a few photos of your pet. We turn them into a desktop companion that follows your cursor — just like the ones in Pets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende ein paar Fotos deines Haustiers. Wir machen daraus einen Schreibtisch-Begleiter, der deinem Cursor folgt – genau wie die bei „Haustiere“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía unas fotos de tu mascota. Las convertimos en un compañero de escritorio que sigue tu cursor, igual que los de Mascotas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez quelques photos de votre animal. Nous en faisons un compagnon de bureau qui suit votre curseur, comme ceux de l'onglet Animaux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペットの写真を数枚送ってください。カーソルを追いかけるデスクトップの相棒に仕上げます。「ペット」のものと同じです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
