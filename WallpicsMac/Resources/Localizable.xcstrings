        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSの壁紙ストアが見つかりません。システム設定で空撮の壁紙を一度選んでから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
