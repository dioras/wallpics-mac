float2x2 rot(float th) {
    float cs = cos(th), si = sin(th);
    return float2x2(cs, -si, si, cs);
}

float Voronesque(float3 p) {
    float3 i = floor(p + dot(p, float3(0.333333)));
    p -= i - dot(i, float3(0.166666));

    float3 i1 = step(p.yzx, p), i2 = max(i1, 1.0 - i1.zxy);
    i1 = min(i1, 1.0 - i1.zxy);

    float3 p1 = p - i1 + 0.166666, p2 = p - i2 + 0.333333, p3 = p - 0.5;

    float3 rnd = float3(7, 157, 113);

    float4 v = max(0.5 - float4(dot(p, p), dot(p1, p1), dot(p2, p2), dot(p3, p3)), 0.0);

    float4 d = float4(dot(i, rnd), dot(i + i1, rnd), dot(i + i2, rnd), dot(i + 1.0, rnd));

    d = fract(sin(d) * 262144.0) * v * 2.0;

    v.x = max(d.x, d.y);
    v.y = max(d.z, d.w);
    v.z = max(min(d.x, d.y), min(d.z, d.w));
    v.w = min(v.x, v.y);

    return max(v.x, v.y) - max(v.z, v.w);
}

fragment float4 fragmentShader(
    VertexOut in [[stage_in]],
    constant Uniforms& uniforms [[buffer(0)]]
) {
    float2 fragCoord = in.uv * uniforms.iResolution;

    float2 uv = (fragCoord - uniforms.iResolution.xy * 0.5) / uniforms.iResolution.y +
                float2(0.5 * cos(uniforms.iTime * 0.5), 0.25 * sin(uniforms.iTime * 0.5));

    float3 rd = normalize(float3(uv, 1));
    rd.xy = rot(sin(uniforms.iTime * 0.25) * 0.5) * rd.xy;
    rd.xz = rot(sin(uniforms.iTime * 0.25) * 0.5) * rd.xz;

    float3 col = float3(0);

    float2 scale = float2(0.75, 1);
    float power = 6.0;
    float sDist = max(dot(pow(abs(rd.xy) * scale, float2(power)), float2(1)), 1e-16);
    sDist = 1.0 / pow(sDist, 1.0 / power);

    float3 sp = float3(0, 0, uniforms.iTime * 2.0) + rd * sDist;

    float3 sn = normalize(-sign(sp) * float3(pow(abs(sp.xy) * scale, float2(power - 1.0)), 0.0));

    const float2 eps = float2(0.025, 0.0);
    float c = Voronesque(sp * 2.5);
    float3 gr = (float3(Voronesque((sp - eps.xyy) * 2.5),
                        Voronesque((sp - eps.yxy) * 2.5),
                        Voronesque((sp - eps.yyx) * 2.5)) - c) / eps.x;
    gr -= sn * dot(sn, gr);
    sn = normalize(sn + gr * 0.1);

    float3 lp = float3(0, 0, uniforms.iTime * 2.0 + 3.0);
    float3 ld = lp - sp;
    float dist = max(length(ld), 0.001);
    ld /= dist;

    float atten = min(1.5 / max(1.0 + dist * 0.25 + dist * dist * 0.5, 0.001), 1.0);

    float diff = max(dot(sn, ld), 0.0);
    float spec = pow(max(dot(reflect(-ld, sn), -rd), 0.0), 16.0);
    float ref = Voronesque((sp + reflect(rd, sn) * 0.5) * 2.5);

    float3 objCol = float3(c, c * 0.8 + 0.2, c * 0.6 + 0.3);

    col = (objCol * (diff + ref * 0.35 + 0.25 + float3(1, 0.9, 0.7) * spec) +
           (c + 0.35) * float3(0.25, 0.5, 1) * ref) * atten;

    return float4(sqrt(clamp(col, 0.0, 1.0)), 1);
}
