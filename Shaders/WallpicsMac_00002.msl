float rand(float2 n) {
    return fract(sin(cos(dot(n, float2(12.9898, 12.1414)))) * 83758.5453);
}

float noise(float2 n) {
    const float2 d = float2(0.0, 1.0);
    float2 b = floor(n), f = smoothstep(float2(0.0), float2(1.0), fract(n));
    return mix(mix(rand(b), rand(b + d.yx), f.x), mix(rand(b + d.xy), rand(b + d.yy), f.x), f.y);
}

float fbm(float2 n) {
    float total = 0.0, amplitude = 1.0;
    for (int i = 0; i < 5; i++) {
        total += noise(n) * amplitude;
        n += n * 1.7;
        amplitude *= 0.47;
    }
    return total;
}

fragment float4 fragmentShader(
    VertexOut in [[stage_in]],
    constant Uniforms& uniforms [[buffer(0)]]
) {
    float2 fragCoord = in.uv * uniforms.iResolution;
    fragCoord.y = uniforms.iResolution.y - fragCoord.y;

    const float3 c1 = float3(0.5, 0.0, 0.1);
    const float3 c2 = float3(0.9, 0.1, 0.0);
    const float3 c3 = float3(0.2, 0.1, 0.7);
    const float3 c4 = float3(1.0, 0.9, 0.1);
    const float3 c5 = float3(0.1);
    const float3 c6 = float3(0.9);

    float2 speed = float2(0.1, 0.9);
    float shift = 1.327 + sin(uniforms.iTime * 2.0) / 2.4;
    float alpha = 1.0;

    float dist = 3.5 - sin(uniforms.iTime * 0.4) / 1.89;

    float2 uv = fragCoord.xy / uniforms.iResolution.xy;
    float2 p = fragCoord.xy * dist / uniforms.iResolution.xx;
    p += sin(p.yx * 4.0 + float2(0.2, -0.3) * uniforms.iTime) * 0.04;
    p += sin(p.yx * 8.0 + float2(0.6, 0.1) * uniforms.iTime) * 0.01;

    p.x -= uniforms.iTime / 1.1;
    float q = fbm(p - uniforms.iTime * 0.3 + 1.0 * sin(uniforms.iTime + 0.5) / 2.0);
    float qb = fbm(p - uniforms.iTime * 0.4 + 0.1 * cos(uniforms.iTime) / 2.0);
    float q2 = fbm(p - uniforms.iTime * 0.44 - 5.0 * cos(uniforms.iTime) / 2.0) - 6.0;
    float q3 = fbm(p - uniforms.iTime * 0.9 - 10.0 * cos(uniforms.iTime) / 15.0) - 4.0;
    float q4 = fbm(p - uniforms.iTime * 1.4 - 20.0 * sin(uniforms.iTime) / 14.0) + 2.0;
    q = (q + qb - 0.4 * q2 - 2.0 * q3 + 0.6 * q4) / 3.8;
    float2 r = float2(fbm(p + q / 2.0 + uniforms.iTime * speed.x - p.x - p.y), fbm(p + q - uniforms.iTime * speed.y));
    float3 c = mix(c1, c2, fbm(p + r)) + mix(c3, c4, r.x) - mix(c5, c6, r.y);
    float3 color = float3(1.0 / (pow(c + 1.61, float3(4.0))) * cos(shift * fragCoord.y / uniforms.iResolution.y));

    color = float3(0.05, 0.2, 1.0) / (pow((r.y + r.y) * max(0.0, p.y) + 0.1, 4.0));

    float3 texSample = float3(
        0.5 + 0.5 * sin(uv.x * 10.0 + uniforms.iTime),
        0.5 + 0.5 * sin(uv.y * 10.0 + uniforms.iTime * 1.1),
        0.5 + 0.5 * sin((uv.x + uv.y) * 10.0 + uniforms.iTime * 1.2)
    );
    color += (texSample * 0.01 * pow((r.y + r.y) * 0.65, 5.0) + 0.055) * mix(float3(0.3, 0.4, 0.9), float3(0.2, 0.5, 0.7), uv.y);
    color = color / (1.0 + max(float3(0), color));

    return float4(color.x, color.y, color.z, alpha);
}
